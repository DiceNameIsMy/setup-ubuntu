# Non-secret config for fractal/backup.sh — pulls the Immich library + a
# fresh DB dump from rpi4 into a local mirror on fractal. Kept separate
# from fractal/.env since that one is Docker Compose's env_file for the
# ML container and shouldn't carry unrelated backup config.

# SSH target for the Immich server (Tailscale MagicDNS name)
REMOTE_HOST=nur@rpi

# Must match UPLOAD_LOCATION in rpi4/.env
REMOTE_UPLOAD_LOCATION=/media/nur/Axagon/immich/library

# Must match the database service's container_name in rpi4/docker-compose.yml
REMOTE_DB_CONTAINER=immich_postgres

# Must match DB_USERNAME in rpi4/.env
REMOTE_DB_USER=postgres

# Where the backup is stored locally on fractal
BACKUP_ROOT=/data/immich-backup
