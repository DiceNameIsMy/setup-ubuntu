[Unit]
Description=Immich Docker Compose stack (server + db + redis; ML offloaded to fractal)
# ExecStopPost resets ALL tailscale serve config on this node - fine as long as
# this is the only thing on the host using `tailscale serve`.
Requires=docker.service
# Won't start until the SSD (DB) and HDD (library, shared with other
# stuff) are mounted at these paths; see install-service.sh, which pins
# them there by UUID.
RequiresMountsFor=/mnt/ssd /mnt/Axagon
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__IMMICH_WORKDIR__
ExecStart=/usr/bin/docker compose up -d
ExecStartPost=/usr/bin/tailscale serve --bg 2283
ExecStop=/usr/bin/docker compose down
ExecStopPost=/usr/bin/tailscale serve reset
TimeoutStartSec=300
User=__IMMICH_USER__

[Install]
WantedBy=multi-user.target
